rules_version = '2';

// 只有你自己的 Google 帳號能讀寫，而且只能讀寫自己 uid 底下的資料
// ⚠️ 把下面的 YOUR_EMAIL@gmail.com 換成你要登入的 Gmail（要和 js/firebase-config.js 的 allowedEmail 一樣）
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'YOUR_EMAIL@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validEntry(d) {
      return d.keys().hasOnly(['date', 'item', 'category', 'amount', 'payment', 'note', 'createdAt', 'updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.amount is number && d.amount >= 0 && d.amount < 1000000
        && d.item is string && d.item.size() <= 100
        && d.category is string && d.category.size() <= 30
        && d.payment is string && d.payment.size() <= 30
        && d.note is string && d.note.size() <= 500;
    }

    function validMeasure(d, day) {
      return d.keys().hasOnly(['date', 'weight', 'waist', 'updatedAt'])
        && d.date == day
        && d.keys().hasAny(['weight', 'waist'])
        && (!('weight' in d) || (d.weight is number && d.weight >= 20 && d.weight <= 400))
        && (!('waist' in d) || (d.waist is number && d.waist >= 30 && d.waist <= 250));
    }

    match /users/{uid} {
      // 帳目
      match /entries/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validEntry(request.resource.data);
      }

      // 每日心得，文件 id 就是日期
      match /journal/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['date', 'text', 'updatedAt'])
          && request.resource.data.date == day
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;
      }

      // 每天的體重和腰圍（文件 id 就是日期；兩個都選填，至少要有一個）
      match /weights/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMeasure(request.resource.data, day);
      }

      // 設定（settings：每週預算、開始日、分類清單；weight：減重目標）
      match /meta/{docId} {
        allow read, write: if isOwner(uid) && docId in ['settings', 'weight'];
      }
    }
  }
}
